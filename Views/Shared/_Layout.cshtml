<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TripPilot | Smart Travel Planner</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons & Google Font (Inter) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light-subtle">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark tp-navbar shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <span class="tp-brand-icon me-2"><i class="bi bi-compass-fill"></i></span>
                    TripPilot
                    <span class="badge bg-info text-dark ms-2 fs-6 fw-semibold">Smart Planner</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#tripPilotNav"
                        aria-controls="tripPilotNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="tripPilotNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Trips" asp-action="Index">
                                <i class="bi bi-map me-1"></i>My Trips
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Trips" asp-action="Calculator">
                                <i class="bi bi-fuel-pump me-1"></i>Fuel Calculator
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Trips" asp-action="Discover">
                                <i class="bi bi-geo-alt me-1"></i>Route & Places
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Trips" asp-action="Alerts">
                                <i class="bi bi-shield-exclamation me-1"></i>Travel Alerts
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-warning fw-semibold px-3 shadow-sm" asp-controller="Trips" asp-action="Create">
                                <i class="bi bi-plus-circle-fill me-1"></i>Plan New Trip
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="tp-footer text-light py-4 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div class="mb-2 mb-md-0">
                <span class="fw-bold"><i class="bi bi-compass-fill text-warning me-1"></i>TripPilot</span>
                <span class="text-white-50 ms-2">&copy; @DateTime.Now.Year — Smart Road Trip & Itinerary Planner (.NET 8 MVC)</span>
            </div>
            <div class="small text-white-50">
                Built with C# Object-Oriented Architecture, ASP.NET Core MVC &amp; EF Core SQL Server
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>