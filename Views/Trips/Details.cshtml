@model TripPilot.Models.Trip
@{
    ViewData["Title"] = Model.Title + " — Trip Workspace";
    var vehicle = Model.Vehicle ?? new TripPilot.Models.VehicleProfile { TripId = Model.Id };
    var currentRangeKm = vehicle.CalculateCurrentRangeKm();
    var fullTankRangeKm = vehicle.CalculateFullTankRangeKm();
    var requiredFuelLiters = vehicle.CalculateRequiredFuelLiters(Model.TotalDistanceKm);
    var remainingFuelLiters = vehicle.CalculateRemainingFuelAfterTripLiters(Model.TotalDistanceKm);
    var estimatedFuelCost = vehicle.CalculateEstimatedFuelCost(Model.TotalDistanceKm);
    var needsRefuel = vehicle.IsRefuelRequired(Model.TotalDistanceKm);

    var totalEstimated = Model.GetTotalEstimatedExpenses();
    var totalActual = Model.GetTotalActualExpenses();
    var remainingBudget = Model.GetRemainingBudget();
    var completedChecklist = Model.ChecklistItems.Count(c => c.IsCompleted);
}

<div class="container mt-4">
    <!-- Top Trip Header Banner -->
    <div class="tp-card p-4 mb-4 bg-dark text-white border-0 shadow">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-info text-dark fw-bold">
                        <i class="bi bi-calendar3 me-1"></i>@Model.DepartureDate.ToString("dd MMM yyyy") – @Model.ReturnDate.ToString("dd MMM yyyy") (@Model.GetTripDurationDays() Days)
                    </span>
                    <span class="badge bg-secondary">
                        <i class="bi bi-signpost-2 me-1"></i>@Model.TotalDistanceKm km (@Model.EstimatedDurationHours hrs drive)
                    </span>
                    @if (needsRefuel)
                    {
                        <span class="badge bg-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Low Fuel Range Warning: Refuel Stop Required
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle-fill me-1"></i>Sufficient Fuel Range (@currentRangeKm km)
                        </span>
                    }
                </div>
                <h2 class="fw-bold mb-1">@Model.Title</h2>
                <p class="text-white-50 mb-0">
                    <i class="bi bi-geo-alt-fill text-info me-1"></i>@Model.StartLocation
                    <i class="bi bi-arrow-right mx-2"></i>
                    <i class="bi bi-flag-fill text-warning me-1"></i>@Model.Destination
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Journey" asp-route-id="@Model.Id" class="btn btn-warning fw-bold">
                    <i class="bi bi-speedometer2 me-1"></i>Launch Journey Mode
                </a>
                <a asp-action="Discover" asp-route-tripId="@Model.Id" class="btn btn-outline-info">
                    <i class="bi bi-compass me-1"></i>Explore Places
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light">
                    <i class="bi bi-pencil me-1"></i>Edit Trip
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: Itinerary Stops & Vehicle/Fuel Calculator -->
        <div class="col-lg-7">
            <!-- A. Multi-Stop Itinerary & Reordering -->
            <div class="tp-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-signpost-split text-primary me-2"></i>Route Itinerary &amp; Stops</h4>
                    <span class="badge bg-primary-subtle text-primary">@Model.Stops.Count Stops</span>
                </div>

                @if (!Model.Stops.Any())
                {
                    <div class="alert alert-light border text-muted small">
                        No intermediate stops added yet. Add fuel stops, restaurants, or attractions below!
                    </div>
                }
                else
                {
                    <div class="tp-timeline mb-4">
                        @foreach (var stop in Model.Stops.OrderBy(s => s.SequenceOrder))
                        {
                            <div class="tp-timeline-item p-3 rounded-3 bg-light border d-flex justify-content-between align-items-start">
                                <span class="tp-timeline-dot">@stop.SequenceOrder</span>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold">@stop.StopName</span>
                                        <span class="badge bg-secondary-subtle text-dark">@stop.Category</span>
                                        <span class="text-muted small">• @stop.DistanceFromStartKm km from start</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(stop.Notes))
                                    {
                                        <div class="small text-muted mt-1">@stop.Notes</div>
                                    }
                                </div>
                                <div class="d-flex gap-1">
                                    <form asp-action="MoveStop" method="post" class="d-inline">
                                        <input type="hidden" name="stopId" value="@stop.Id" />
                                        <input type="hidden" name="direction" value="up" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move Up">
                                            <i class="bi bi-arrow-up"></i>
                                        </button>
                                    </form>
                                    <form asp-action="MoveStop" method="post" class="d-inline">
                                        <input type="hidden" name="stopId" value="@stop.Id" />
                                        <input type="hidden" name="direction" value="down" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move Down">
                                            <i class="bi bi-arrow-down"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteStop" method="post" class="d-inline">
                                        <input type="hidden" name="stopId" value="@stop.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Stop">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Add New Stop Form -->
                <form asp-action="AddStop" method="post" class="border-top pt-3">
                    <input type="hidden" name="tripId" value="@Model.Id" />
                    <h6 class="fw-bold mb-2"><i class="bi bi-plus-circle text-primary me-1"></i>Add Stop to Itinerary</h6>
                    <div class="row g-2">
                        <div class="col-md-5">
                            <input type="text" name="stopName" class="form-control form-control-sm" placeholder="Stop name (e.g., Highway Fuel Pump)" required />
                        </div>
                        <div class="col-md-4">
                            <select name="category" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TripPilot.Models.StopCategory>()"></select>
                        </div>
                        <div class="col-md-3">
                            <input type="number" step="0.1" name="distanceFromStartKm" class="form-control form-control-sm" placeholder="At km (e.g. 120)" required />
                        </div>
                        <div class="col-md-9">
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="Optional note (e.g., 20-min tea break & fuel check)" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">Add Stop</button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- B. Vehicle & Fuel Calculator Card -->
            <div class="tp-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="fw-bold mb-0"><i class="bi bi-fuel-pump-fill text-warning me-2"></i>Vehicle &amp; Fuel Calculator</h4>
                    <span class="badge bg-dark">@vehicle.VehicleType • @vehicle.FuelType</span>
                </div>
                <p class="small text-muted mb-3">
                    <i class="bi bi-info-circle me-1"></i>Note: Fuel level, tank capacity, and mileage are manually entered unless a supported live vehicle/OBD integration is configured.
                </p>

                @if (needsRefuel)
                {
                    <div class="alert alert-danger d-flex align-items-center py-2 px-3 small">
                        <i class="bi bi-exclamation-octagon-fill fs-5 me-2"></i>
                        <div>
                            <strong>Insufficient Fuel Range Warning!</strong> Your current fuel (@vehicle.CurrentFuelLiters L) gives an estimated range of <strong>@currentRangeKm km</strong>, which is less than your <strong>@Model.TotalDistanceKm km</strong> route (plus a 40 km safety buffer). Plan a fuel stop before <strong>@Math.Max(10, currentRangeKm - 40) km</strong>!
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success d-flex align-items-center py-2 px-3 small">
                        <i class="bi bi-shield-check fs-5 me-2"></i>
                        <div>
                            <strong>Fuel Range Sufficient:</strong> Current fuel (@vehicle.CurrentFuelLiters L) provides <strong>@currentRangeKm km</strong> range for your <strong>@Model.TotalDistanceKm km</strong> trip, leaving approximately <strong>@remainingFuelLiters L</strong> in reserve.
                        </div>
                    </div>
                }

                <div class="row g-2 text-center mb-3">
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <div class="small text-muted">Current Range</div>
                            <div class="fw-bold fs-5">@currentRangeKm km</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <div class="small text-muted">Full Tank Range</div>
                            <div class="fw-bold fs-5">@fullTankRangeKm km</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <div class="small text-muted">Fuel Required</div>
                            <div class="fw-bold fs-5 text-primary">@requiredFuelLiters L</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 rounded bg-light border">
                            <div class="small text-muted">Est. Fuel Cost</div>
                            <div class="fw-bold fs-5 text-success">₹@estimatedFuelCost.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                <form asp-action="UpdateVehicle" method="post" class="border-top pt-3">
                    <input type="hidden" name="tripId" value="@Model.Id" />
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Vehicle Name</label>
                            <input type="text" name="vehicleName" value="@vehicle.VehicleName" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Vehicle Type</label>
                            <select name="vehicleType" asp-for="Vehicle.VehicleType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TripPilot.Models.VehicleType>()"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Fuel Type</label>
                            <select name="fuelType" asp-for="Vehicle.FuelType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TripPilot.Models.FuelType>()"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Mileage (km/L)</label>
                            <input type="number" step="0.1" name="mileageKmPerLiter" value="@vehicle.MileageKmPerLiter" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Tank Size (L)</label>
                            <input type="number" step="0.5" name="tankCapacityLiters" value="@vehicle.TankCapacityLiters" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Current Fuel (L)</label>
                            <input type="number" step="0.5" name="currentFuelLiters" value="@vehicle.CurrentFuelLiters" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Price (₹/L)</label>
                            <input type="number" step="0.1" name="fuelPricePerLiter" value="@vehicle.FuelPricePerLiter" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-12 mt-2 text-end">
                            <button type="submit" class="btn btn-warning btn-sm fw-bold px-3">
                                <i class="bi bi-calculator me-1"></i>Recalculate &amp; Save Fuel Profile
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: Budget/Expenses & Packing Checklist -->
        <div class="col-lg-5">
            <!-- E. Budget & Expense Management -->
            <div class="tp-card p-4 mb-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-wallet2 text-success me-2"></i>Budget &amp; Expense Tracker</h4>

                <div class="row g-2 text-center mb-3 small">
                    <div class="col-4">
                        <div class="p-2 rounded bg-light border">
                            <div class="text-muted">Total Budget</div>
                            <div class="fw-bold">₹@Model.OverallBudget.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-light border">
                            <div class="text-muted">Est. vs Actual</div>
                            <div class="fw-bold">₹@totalEstimated.ToString("N0") / ₹@totalActual.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-light border">
                            <div class="text-muted">Remaining</div>
                            <div class="fw-bold @(remainingBudget < 0 ? "text-danger" : "text-success")">₹@remainingBudget.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                @if (Model.Expenses.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Expense</th>
                                    <th>Est.</th>
                                    <th>Actual</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in Model.Expenses)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@exp.Title</div>
                                            <span class="badge bg-light text-secondary border">@exp.Category</span>
                                        </td>
                                        <td>₹@exp.EstimatedAmount.ToString("N0")</td>
                                        <td class="fw-bold">₹@exp.ActualAmount.ToString("N0")</td>
                                        <td class="text-end">
                                            <form asp-action="DeleteExpense" method="post">
                                                <input type="hidden" name="expenseId" value="@exp.Id" />
                                                <button type="submit" class="btn btn-link text-danger p-0"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-action="AddExpense" method="post" class="border-top pt-3">
                    <input type="hidden" name="tripId" value="@Model.Id" />
                    <h6 class="fw-bold small mb-2">Record Estimated / Actual Expense</h6>
                    <div class="row g-2">
                        <div class="col-7">
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="Expense item (e.g. Hotel Stay)" required />
                        </div>
                        <div class="col-5">
                            <select name="category" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TripPilot.Models.ExpenseCategory>()"></select>
                        </div>
                        <div class="col-5">
                            <input type="number" step="10" name="estimatedAmount" class="form-control form-control-sm" placeholder="Estimated ₹" required />
                        </div>
                        <div class="col-5">
                            <input type="number" step="10" name="actualAmount" class="form-control form-control-sm" placeholder="Actual Spent ₹" required />
                        </div>
                        <div class="col-2">
                            <button type="submit" class="btn btn-success btn-sm w-100"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- F. Packing & Trip Organization Checklist -->
            <div class="tp-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-check2-square text-info me-2"></i>Packing &amp; To-Do Checklist</h4>
                    <span class="badge bg-info-subtle text-dark">@completedChecklist / @Model.ChecklistItems.Count Done</span>
                </div>

                <ul class="list-group list-group-flush mb-3">
                    @foreach (var item in Model.ChecklistItems.OrderBy(c => c.IsCompleted))
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="ToggleChecklistItem" method="post" class="m-0">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-success" : "btn-outline-secondary")">
                                        <i class="bi @(item.IsCompleted ? "bi-check-lg" : "bi-square")"></i>
                                    </button>
                                </form>
                                <div>
                                    <div class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "fw-medium")">@item.ItemName</div>
                                    <small class="text-muted">@item.Category</small>
                                </div>
                            </div>
                            <form asp-action="DeleteChecklistItem" method="post">
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm text-danger"><i class="bi bi-x-lg"></i></button>
                            </form>
                        </li>
                    }
                </ul>

                <form asp-action="AddChecklistItem" method="post" class="border-top pt-3">
                    <input type="hidden" name="tripId" value="@Model.Id" />
                    <div class="row g-2">
                        <div class="col-12">
                            <input type="text" name="itemName" class="form-control form-control-sm" placeholder="Add packing item or travel task..." required />
                        </div>
                        <div class="col-8">
                            <select name="category" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TripPilot.Models.ChecklistCategory>()"></select>
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-info btn-sm w-100 fw-semibold">Add Item</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>