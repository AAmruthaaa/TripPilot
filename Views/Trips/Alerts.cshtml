@model TripPilot.Models.Trip
@{
    ViewData["Title"] = "Travel Alerts & Safety Advisories";
    var trips = ViewBag.Trips as List<TripPilot.Models.Trip> ?? new List<TripPilot.Models.Trip>();
    var destination = Model?.Destination ?? "Hampi, Karnataka";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-exclamation text-danger me-2"></i>Travel Alerts &amp; Safety Center</h2>
            <p class="text-muted small mb-0">
                Real-time meteorological conditions from Open-Meteo API with source &amp; timestamp verification, plus national highway emergency resources.
            </p>
        </div>

        @if (trips.Any())
        {
            <form method="get" asp-action="Alerts" class="d-flex gap-2">
                <select name="tripId" class="form-select form-select-sm">
                    @foreach (var t in trips)
                    {
                        <option value="@t.Id" selected="@(Model != null && t.Id == Model.Id)">
                            @t.Title (@t.Destination)
                        </option>
                    }
                </select>
                <button type="submit" class="btn btn-primary btn-sm px-3">Check Trip</button>
            </form>
        }
    </div>

    <!-- Live Destination Weather Alert Card -->
    <div class="tp-card p-4 mb-4 border-start border-4 border-primary">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge bg-success me-2"><i class="bi bi-broadcast me-1"></i>LIVE METEOROLOGICAL FEED</span>
                <span class="text-muted small" id="weatherSourceStamp">Source: Open-Meteo Forecast API • Fetching timestamp...</span>
            </div>
            <div class="d-flex gap-2">
                <input type="text" id="alertLocationInput" class="form-control form-control-sm" value="@destination" style="width: 220px;" />
                <button type="button" id="btnRefreshWeather" class="btn btn-sm btn-primary">Refresh Live Feed</button>
            </div>
        </div>

        <div id="liveWeatherBox" class="py-2">
            <div class="spinner-border spinner-border-sm text-primary me-2"></div>Fetching live weather &amp; road visibility conditions...
        </div>
    </div>

    <!-- Verified Reference & Emergency Services (Clearly labeled Reference / Non-Live) -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="tp-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-telephone-inbound-fill text-danger me-2"></i>Emergency &amp; Highway Helplines</h5>
                    <span class="badge bg-secondary-subtle text-dark border">Official Reference Directory</span>
                </div>
                <p class="small text-muted mb-3">Keep these verified national emergency numbers accessible during highway travel:</p>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span><strong>National Highway Helpline (NHAI)</strong> (Breakdown / Toll / Crane)</span>
                        <span class="badge bg-danger fs-6">1033</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span><strong>Unified Emergency Response Support (ERSS)</strong></span>
                        <span class="badge bg-dark fs-6">112</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span><strong>Medical / Ambulance Emergency</strong></span>
                        <span class="badge bg-primary fs-6">108</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-md-6">
            <div class="tp-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-cone-striped text-warning me-2"></i>Road Closures &amp; Attraction Status</h5>
                    <span class="badge bg-warning-subtle text-dark border">Integration Transparency Notice</span>
                </div>
                <p class="small text-muted mb-2">
                    TripPilot never fabricates fake live road closures or ticket availability.
                </p>
                <div class="alert alert-light border small mb-0">
                    <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill text-primary me-1"></i>How TripPilot Handles Route &amp; Closure Data:</div>
                    <ul class="mb-0 ps-3">
                        <li><strong>Live Weather &amp; Wind Alerts:</strong> Fetched in real time above via the Open-Meteo API with exact UTC/local observation timestamps.</li>
                        <li><strong>Fuel Range Warnings:</strong> Calculated directly from your trip's vehicle profile (@(Model?.Vehicle?.CalculateCurrentRangeKm() ?? 0) km current range vs @(Model?.TotalDistanceKm ?? 0) km trip distance).</li>
                        <li><strong>Live Highway Traffic / Closures:</strong> Requires a commercial traffic provider key (e.g., Google Routes API or TomTom Traffic) in <code>appsettings.json</code>.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function fetchLiveWeatherAlert() {
            const loc = document.getElementById('alertLocationInput').value;
            const box = document.getElementById('liveWeatherBox');
            const stamp = document.getElementById('weatherSourceStamp');

            box.innerHTML = `<div class="spinner-border spinner-border-sm text-primary me-2"></div>Checking live Open-Meteo satellite & station data for <strong>${loc}</strong>...`;

            try {
                const geoRes = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(loc)}`);
                const geoData = await geoRes.json();
                if (!geoData || geoData.length === 0) {
                    box.innerHTML = `<div class="alert alert-warning mb-0">Location not found. Please enter a valid city or destination name.</div>`;
                    return;
                }

                const { lat, lon, display_name } = geoData[0];
                const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,precipitation,rain,wind_speed_10m,weather_code&timezone=auto`;
                const wRes = await fetch(weatherUrl);
                const wData = await wRes.json();
                const cur = wData.current;

                const temp = cur.temperature_2m;
                const wind = cur.wind_speed_10m;
                const rain = cur.precipitation;
                const obsTime = new Date(cur.time).toLocaleString();

                stamp.innerText = `Source: Open-Meteo API (nominatim + api.open-meteo.com) • Observed: ${obsTime}`;

                let alertLevel = 'alert-success';
                let advisory = 'Clear driving conditions. Normal highway speeds and standard visibility expected.';
                if (rain > 2.0 || wind > 40) {
                    alertLevel = 'alert-danger';
                    advisory = 'Active Rain / High Wind Advisory: Reduce highway driving speed, increase braking distance, and keep low-beam headlights on.';
                } else if (temp > 38) {
                    alertLevel = 'alert-warning';
                    advisory = 'High Heat Advisory: Check tire pressure, coolant levels, and carry extra drinking water in the vehicle.';
                }

                box.innerHTML = `
                            <div class="fw-bold mb-2"><i class="bi bi-geo-alt-fill text-primary me-1"></i>${display_name}</div>
                            <div class="row g-3 mb-3">
                                <div class="col-sm-4">
                                    <div class="p-3 rounded bg-light border">
                                        <div class="text-muted small">Current Temperature</div>
                                        <div class="fs-4 fw-bold">${temp} °C</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-3 rounded bg-light border">
                                        <div class="text-muted small">Wind Speed (10m)</div>
                                        <div class="fs-4 fw-bold">${wind} km/h</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="p-3 rounded bg-light border">
                                        <div class="text-muted small">Precipitation</div>
                                        <div class="fs-4 fw-bold">${rain} mm</div>
                                    </div>
                                </div>
                            </div>
                            <div class="alert ${alertLevel} mb-0 small">
                                <strong><i class="bi bi-exclamation-circle-fill me-1"></i>Driver Weather Advisory:</strong> ${advisory}
                            </div>
                        `;
            } catch (err) {
                box.innerHTML = `<div class="alert alert-secondary mb-0">Could not reach live weather feed. Check your internet connection.</div>`;
            }
        }

        document.getElementById('btnRefreshWeather').addEventListener('click', fetchLiveWeatherAlert);
        fetchLiveWeatherAlert();
    </script>
}