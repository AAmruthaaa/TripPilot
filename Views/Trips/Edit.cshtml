@model TripPilot.Models.Trip
@{
    ViewData["Title"] = "Edit Trip";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="tp-card p-4 p-md-5">
                <h3 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Trip Details</h3>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StartLocation" class="form-label fw-semibold"></label>
                            <input asp-for="StartLocation" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Destination" class="form-label fw-semibold"></label>
                            <input asp-for="Destination" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartureDate" class="form-label fw-semibold"></label>
                            <input asp-for="DepartureDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReturnDate" class="form-label fw-semibold"></label>
                            <input asp-for="ReturnDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TotalDistanceKm" class="form-label fw-semibold"></label>
                            <input asp-for="TotalDistanceKm" type="number" step="0.1" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EstimatedDurationHours" class="form-label fw-semibold"></label>
                            <input asp-for="EstimatedDurationHours" type="number" step="0.1" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OverallBudget" class="form-label fw-semibold">Overall Budget (₹)</label>
                            <input asp-for="OverallBudget" type="number" step="100" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>