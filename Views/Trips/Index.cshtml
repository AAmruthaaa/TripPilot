@model IEnumerable<TripPilot.Models.Trip>
@{
    ViewData["Title"] = "My Saved Trips";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-map text-primary me-2"></i>My Saved Trips</h2>
            <p class="text-muted mb-0">Manage your road trip itineraries, vehicle profiles, budgets, and route stops.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-semibold px-4">
            <i class="bi bi-plus-circle me-1"></i>Plan New Trip
        </a>
    </div>

    <div class="row g-4">
        @foreach (var trip in Model)
        {
            <div class="col-md-6">
                <div class="tp-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary">
                                @trip.DepartureDate.ToString("dd MMM yyyy") – @trip.ReturnDate.ToString("dd MMM yyyy")
                            </span>
                            <span class="fw-bold text-success">Budget: ₹@trip.OverallBudget.ToString("N0")</span>
                        </div>
                        <h4 class="fw-bold">@trip.Title</h4>
                        <p class="text-muted mb-2">
                            <i class="bi bi-geo-alt-fill text-primary"></i> @trip.StartLocation
                            <i class="bi bi-arrow-right mx-1"></i>
                            <i class="bi bi-flag-fill text-danger"></i> @trip.Destination
                        </p>
                        <p class="small text-secondary mb-3">@trip.Notes</p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@trip.Id" class="btn btn-primary btn-sm">
                                <i class="bi bi-folder2-open me-1"></i>Open Workspace
                            </a>
                            <a asp-action="Journey" asp-route-id="@trip.Id" class="btn btn-dark btn-sm">
                                <i class="bi bi-compass me-1"></i>Journey Mode
                            </a>
                            <a asp-action="Edit" asp-route-id="@trip.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                        </div>
                        <form asp-action="Delete" asp-route-id="@trip.Id" method="post" onsubmit="return confirm('Delete this trip?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>